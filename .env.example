# Copy to .env to override YAML settings. Mock clients need no credentials.
# DIAGAGENT_LLM__API_KEY=
# DIAGAGENT_LLM__BASE_URL=https://api.openai.com/v1
# A dedicated judge requires both provider and model in YAML or environment overrides.
# DIAGAGENT_JUDGE_LLM__PROVIDER=openai_compatible
# DIAGAGENT_JUDGE_LLM__MODEL=your-judge-model
# DIAGAGENT_JUDGE_LLM__BASE_URL=https://api.openai.com/v1
# DIAGAGENT_JUDGE_LLM__API_KEY=
# DIAGAGENT_JUDGE_LLM__TEMPERATURE=0
# DIAGAGENT_JUDGE_LLM__JSON_MODE=true
# DIAGAGENT_EMBEDDING__API_KEY=
# DIAGAGENT_EMBEDDING__BASE_URL=https://api.openai.com/v1
# DIAGAGENT_LOG_LEVEL=DEBUG
# DIAGAGENT_API__API_KEY=
# DIAGAGENT_API__ADMIN_API_KEY=
# DIAGAGENT_API__CORS_ALLOW_ORIGINS=["https://ops.example.com"]
# DIAGAGENT_API__RATE_LIMIT_RPM=120
# DIAGAGENT_API__ENABLE_METRICS=true
# DIAGAGENT_API__ENABLE_DEMO_UI=true
# DIAGAGENT_PATHS__CACHE_FILE=data/cache/semantic.sqlite3
# DIAGAGENT_CACHE__SIMILARITY_THRESHOLD=0.95
# DIAGAGENT_CACHE__TTL_SECONDS=86400
# DIAGAGENT_CACHE__MAX_ENTRIES=10000
# DIAGAGENT_INGESTION__PRUNE_GENERATIONS_ON_INGEST=true
